/* Discoop styling. The main screen takes every colour from the theme (ansi-dark = the terminal's own palette). */

Screen {
    layout: vertical;
}

/* ==================== Top Bar ==================== */

#top-bar {
    height: 1;
    padding: 0 1;
}

#app-title {
    text-style: bold;
    margin-right: 2;
}

#status-indicator {
    margin-right: 2;
}

#status-indicator.-ok {
    color: $success;
}

#status-indicator.-bad {
    color: $error;
}

#status-indicator.-warn {
    color: $warning;
}

#mode-indicator {
    color: $success;
}

#mode-indicator.-fast {
    color: $warning;
}

#help-hint {
    width: 1fr;
    text-align: right;
    color: $text-muted;
    text-style: dim;
}

/* ==================== Panels ==================== */

#main-columns {
    layout: horizontal;
    height: 1fr;
}

.pane {
    border: round $text-muted;
    border-title-color: $text-muted;
    padding: 0 1;
}

.pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#tree-pane,
#export-pane {
    width: 1fr;
    height: 100%;
}

#log-pane {
    height: 8;
}

/* One panel at a time in a narrow window. The log stays at the bottom and fills the window on its own tab. */

Screen.-narrow.show-tab-1 #export-pane {
    display: none;
}

Screen.-narrow.show-tab-2 #tree-pane {
    display: none;
}

Screen.-narrow.show-tab-3 #main-columns {
    display: none;
}

Screen.-narrow.show-tab-3 #log-pane {
    height: 1fr;
}

/* ==================== Tree ==================== */

#channel-tree {
    height: 1fr;
    overflow-x: hidden;
}

#channel-tree > .tree--cursor {
    text-style: underline;
}

#channel-tree:focus > .tree--cursor {
    text-style: bold;
}

/* ==================== Export Panel ==================== */

#selected-title {
    color: $text-muted;
    text-style: bold;
}

#selected-list {
    height: auto;
    max-height: 5;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#export-form {
    height: 1fr;
    margin-top: 1;
}

#row-start {
    margin-top: 1;
}

/* ==================== Log Panel ==================== */

#run-bar {
    height: 1;
}

#run-status {
    width: 1fr;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#job-progress {
    width: auto;
    height: 1;
}

#job-progress Bar {
    width: 20;
}

#event-log {
    height: 1fr;
}

/* ==================== Command Line ==================== */

#command-bar {
    height: 1;
    padding: 0 1;
}

#command-prefix {
    width: auto;
    color: $accent;
    text-style: bold;
    margin-right: 1;
}

#command-preview {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#command-hint {
    width: auto;
    color: $text-muted;
    text-style: dim;
    margin-left: 1;
}

/* ==================== Shared With The Dialogs ==================== */

.section-label {
    text-style: bold;
    color: $text-muted;
    margin-top: 1;
    margin-bottom: 0;
}

.button-bar {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.button-bar Button {
    margin-right: 1;
    min-width: 8;
}

.input-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.input-row Label {
    width: 14;
    content-align: left middle;
}

.input-row Input {
    width: 1fr;
    border: none;
}

/* ==================== Modal Screens ==================== */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.modal-dialog {
    background: #2b2d31;
    border: thick #5865F2;
    padding: 1 2;
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 88%;
}

.modal-title {
    text-style: bold;
    color: #f2f3f5;
    margin-bottom: 1;
    border-bottom: solid #383a40;
    padding-bottom: 1;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    height: auto;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
    min-width: 10;
}

.error-text {
    color: #ed4245;
    text-style: bold;
    margin: 1 0;
}

/* Help Screen */

#help-dialog {
    width: 90;
    max-width: 95%;
    height: 85%;
}

#tab-tui-guide {
    padding: 1;
}

#tab-cli-help {
    padding: 1;
}

#cli-help-scroll {
    height: 1fr;
    background: #1e1f22;
    border: solid #383a40;
    padding: 1;
}

#cli-help-content {
    color: #dbdee1;
}

/* Preview Screen */

#preview-dialog {
    width: 92;
    max-width: 96%;
    height: 90%;
}

#preview-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

#preview-search {
    width: 1fr;
    background: #1e1f22;
    color: #f2f3f5;
    margin-left: 1;
}

#preview-scroll {
    height: 1fr;
    background: #1e1f22;
    border: solid #383a40;
    padding: 1;
}

#preview-content {
    color: #dbdee1;
}

/* ==================== Login Modal ==================== */

.login-modal-dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
}

#qr-container {
    align: center middle;
    height: auto;
    margin: 1 0;
}

#btn-login-qr {
    background: #5865F2;
    color: #ffffff;
    text-style: bold;
    min-width: 24;
    margin-bottom: 1;
}

#btn-login-qr:hover {
    background: #4752c4;
}

#qr-box {
    width: auto;
    height: auto;
    content-align: center middle;
}

#qr-status-lbl {
    text-align: center;
    width: 100%;
    margin-top: 1;
    color: #dbdee1;
}

#qr-countdown-lbl {
    text-align: center;
    width: 100%;
    color: #fee75c;
    text-style: bold;
}
