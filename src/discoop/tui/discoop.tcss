/* Discoop Textual Styling - Discord-inspired theme */

Screen {
    background: #1e1f22;
    color: #dbdee1;
}

/* ==================== Top Status Bar ==================== */

#top-bar {
    dock: top;
    height: 3;
    background: #232428;
    border-bottom: solid #383a40;
    layout: horizontal;
    padding: 0 1;
}

#status-indicator {
    width: auto;
    content-align: left middle;
    text-style: bold;
    color: #57f287;
    padding: 0 1;
}

#status-indicator.not-logged-in {
    color: #ed4245;
}

#mode-indicator {
    width: auto;
    content-align: left middle;
    text-style: bold;
    padding: 0 1;
    color: #fee75c;
}

#size-indicator {
    width: auto;
    content-align: left middle;
    color: #949ba4;
    padding: 0 1;
}

.top-bar-spacer {
    width: 1fr;
}

.top-bar-btn {
    margin: 0 1;
    min-width: 10;
    height: 1;
    border: none;
    background: #313338;
    color: #f2f3f5;
}

.top-bar-btn:hover {
    background: #5865F2;
    color: #ffffff;
}

/* ==================== Narrow Tabs Bar ==================== */

#narrow-tabs {
    height: 3;
    background: #2b2d31;
    border-bottom: solid #383a40;
    layout: horizontal;
    align: center middle;
    padding: 0 1;
}

.narrow-tab-btn {
    margin: 0 1;
    min-width: 16;
    height: 1;
    border: none;
    background: #383a40;
    color: #dbdee1;
}

.narrow-tab-btn.-active {
    background: #5865F2;
    color: #ffffff;
    text-style: bold;
}

/* ==================== Main Columns Responsive Layout ==================== */

#main-columns {
    height: 1fr;
    margin: 0;
    padding: 0;
}

Screen.-wide #narrow-tabs {
    display: none;
}

Screen.-wide #main-columns {
    layout: horizontal;
}

Screen.-wide #servers-pane {
    display: block;
    width: 25%;
    height: 100%;
}

Screen.-wide #channels-pane {
    display: block;
    width: 35%;
    height: 100%;
}

Screen.-wide #export-pane {
    display: block;
    width: 40%;
    height: 100%;
}

Screen.-wide #export-settings-box {
    display: block;
}

Screen.-wide #progress-box {
    display: block;
}

/* Narrow mode breakpoints */

Screen.-narrow #narrow-tabs {
    display: block;
}

Screen.-narrow #main-columns {
    layout: vertical;
}

Screen.-narrow.show-tab-1 #servers-pane {
    display: block;
    width: 100%;
    height: 40%;
}

Screen.-narrow.show-tab-1 #channels-pane {
    display: block;
    width: 100%;
    height: 60%;
}

Screen.-narrow.show-tab-1 #export-pane {
    display: none;
}

Screen.-narrow.show-tab-2 #servers-pane {
    display: none;
}

Screen.-narrow.show-tab-2 #channels-pane {
    display: none;
}

Screen.-narrow.show-tab-2 #export-pane {
    display: block;
    width: 100%;
    height: 100%;
}

Screen.-narrow.show-tab-2 #export-settings-box {
    display: block;
    height: 100%;
}

Screen.-narrow.show-tab-2 #progress-box {
    display: none;
}

Screen.-narrow.show-tab-3 #servers-pane {
    display: none;
}

Screen.-narrow.show-tab-3 #channels-pane {
    display: none;
}

Screen.-narrow.show-tab-3 #export-pane {
    display: block;
    width: 100%;
    height: 100%;
}

Screen.-narrow.show-tab-3 #export-settings-box {
    display: none;
}

Screen.-narrow.show-tab-3 #progress-box {
    display: block;
    height: 100%;
}

/* ==================== Panes Styling ==================== */

.pane {
    background: #2b2d31;
    border: round #5865F2;
    padding: 0 1;
}

.pane:focus-within {
    border: round #ffffff;
}

.pane-header {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid #383a40;
}

.pane-title {
    text-style: bold;
    color: #f2f3f5;
    padding: 0 0 0 0;
}

.button-bar {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.button-bar Button {
    margin-right: 1;
    min-width: 8;
    height: 1;
}

/* ==================== Servers Pane ==================== */

#server-list {
    height: 1fr;
    background: #1e1f22;
    border: none;
}

#server-list > .option-list--option-highlighted {
    background: #5865F2;
    color: #ffffff;
}

/* ==================== Channels Pane ==================== */

#channel-search {
    margin: 0 0 1 0;
    background: #1e1f22;
    border: none;
    color: #f2f3f5;
}

#channel-tree {
    height: 1fr;
    background: #1e1f22;
    border: none;
}

#channel-tree:focus {
    border: none;
}

/* ==================== Export Pane ==================== */

#export-pane {
    overflow-y: auto;
}

#export-settings-box {
    height: auto;
}

#selected-list {
    height: 8;
    min-height: 5;
    background: #1e1f22;
    margin: 0 0 1 0;
    border: none;
}

.section-label {
    text-style: bold;
    color: #949ba4;
    margin-top: 1;
    margin-bottom: 0;
}

.input-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.input-row Label {
    width: 14;
    content-align: left middle;
}

.input-row Input {
    width: 1fr;
    background: #1e1f22;
    border: none;
    color: #f2f3f5;
}

.checkbox-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.checkbox-row Checkbox {
    margin-right: 2;
}

.radio-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.radio-row Button {
    margin-right: 1;
    min-width: 8;
    height: 1;
}

.radio-row Button.-active {
    background: #5865F2;
    color: #ffffff;
    text-style: bold;
}

.action-row {
    layout: horizontal;
    height: 3;
    margin: 1 0;
}

#btn-start {
    width: 1fr;
    background: #57f287;
    color: #1e1f22;
    text-style: bold;
    margin-right: 1;
}

#btn-start:hover {
    background: #3ba55d;
}

#btn-stop {
    width: auto;
    min-width: 12;
    background: #ed4245;
    color: #ffffff;
    text-style: bold;
}

#btn-stop:hover {
    background: #da373c;
}

/* ==================== Progress Box ==================== */

#progress-box {
    margin-top: 1;
    border-top: solid #383a40;
    padding-top: 1;
    height: auto;
}

#run-status {
    text-style: bold;
    color: #fee75c;
    margin-bottom: 0;
}

#job-progress {
    margin: 1 0;
}

#event-log {
    height: 10;
    min-height: 6;
    background: #1e1f22;
    border: solid #383a40;
    padding: 0 1;
}

/* ==================== Bottom Command Bar ==================== */

#command-bar {
    dock: bottom;
    height: 3;
    background: #1e1f22;
    border-top: solid #5865F2;
    layout: horizontal;
    padding: 0 1;
    align: left middle;
}

#command-prefix {
    width: auto;
    text-style: bold;
    color: #5865F2;
    padding-right: 1;
}

#command-preview {
    width: 1fr;
    color: #57f287;
    text-style: bold;
}

#btn-copy-command {
    width: auto;
    min-width: 8;
    height: 1;
    margin-left: 1;
    background: #383a40;
    color: #dbdee1;
}

#btn-copy-command:hover {
    background: #5865F2;
    color: #ffffff;
}

/* ==================== Modal Screens ==================== */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.modal-dialog {
    background: #2b2d31;
    border: thick #5865F2;
    padding: 1 2;
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 88%;
}

.modal-title {
    text-style: bold;
    color: #f2f3f5;
    margin-bottom: 1;
    border-bottom: solid #383a40;
    padding-bottom: 1;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    height: auto;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
    min-width: 10;
}

.error-text {
    color: #ed4245;
    text-style: bold;
    margin: 1 0;
}

/* Help Screen */

#help-dialog {
    width: 90;
    max-width: 95%;
    height: 85%;
}

#tab-tui-guide {
    padding: 1;
}

#tab-cli-help {
    padding: 1;
}

#cli-help-scroll {
    height: 1fr;
    background: #1e1f22;
    border: solid #383a40;
    padding: 1;
}

#cli-help-content {
    color: #dbdee1;
}

/* Preview Screen */

#preview-dialog {
    width: 92;
    max-width: 96%;
    height: 90%;
}

#preview-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

#preview-search {
    width: 1fr;
    background: #1e1f22;
    color: #f2f3f5;
    margin-left: 1;
}

#preview-scroll {
    height: 1fr;
    background: #1e1f22;
    border: solid #383a40;
    padding: 1;
}

#preview-content {
    color: #dbdee1;
}
