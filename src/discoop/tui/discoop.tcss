/* Discoop styling. Every colour comes from the theme (ansi-dark = the terminal's own palette). */

Screen {
    layout: vertical;
}

/* ==================== Top Bar ==================== */

#top-bar {
    height: 1;
    padding: 0 1;
}

#app-title {
    text-style: bold;
    margin-right: 2;
}

#status-indicator {
    margin-right: 2;
}

#status-indicator.-ok {
    color: $success;
}

#status-indicator.-bad {
    color: $error;
}

#status-indicator.-warn {
    color: $warning;
}

#mode-indicator {
    color: $success;
}

#mode-indicator.-fast {
    color: $warning;
}

#help-hint {
    width: 1fr;
    text-align: right;
    color: $text-muted;
    text-style: dim;
}

/* ==================== Panels ==================== */

#main-columns {
    layout: horizontal;
    height: 1fr;
}

.pane {
    border: round $text-muted;
    border-title-color: $text-muted;
    padding: 0 1;
}

.pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#tree-pane,
#export-pane {
    width: 1fr;
    height: 100%;
}

#log-pane {
    height: 8;
}

/* One panel at a time in a narrow window. The log stays at the bottom and fills the window on its own tab. */

Screen.-narrow.show-tab-1 #export-pane {
    display: none;
}

Screen.-narrow.show-tab-2 #tree-pane {
    display: none;
}

Screen.-narrow.show-tab-3 #main-columns {
    display: none;
}

Screen.-narrow.show-tab-3 #log-pane {
    height: 1fr;
}

/* ==================== Tree ==================== */

#channel-tree {
    height: 1fr;
    overflow-x: hidden;
}

#channel-tree > .tree--cursor {
    text-style: underline;
}

#channel-tree:focus > .tree--cursor {
    text-style: bold;
}

/* ==================== Export Panel ==================== */

#selected-title {
    color: $text-muted;
    text-style: bold;
}

#selected-list {
    height: auto;
    max-height: 5;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#export-form {
    height: 1fr;
    margin-top: 1;
}

#row-start {
    margin-top: 1;
}

#threads-warning {
    display: none;
    width: 100%;
    color: $warning;
}

/* ==================== Log Panel ==================== */

#run-bar {
    height: 1;
}

#run-status {
    width: 1fr;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#job-progress {
    width: auto;
    height: 1;
}

#job-progress Bar {
    width: 20;
}

#event-log {
    height: 1fr;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* ==================== Command Line ==================== */

#command-bar {
    height: 1;
    padding: 0 1;
}

#command-prefix {
    width: auto;
    color: $accent;
    text-style: bold;
    margin-right: 1;
}

#command-preview {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#command-hint {
    width: auto;
    color: $text-muted;
    text-style: dim;
    margin-left: 1;
}

/* ==================== Dialogs ==================== */

ModalScreen {
    align: center middle;
}

.dialog {
    width: 72;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 0 1;
    background: $background;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

.dialog FormPanel {
    height: auto;
}

.dialog-error {
    display: none;
    margin-top: 1;
    color: $error;
    text-style: bold;
}

#row-modal-save,
#row-cfg-save {
    margin-top: 1;
}

/* Help and Preview */

#help-dialog {
    width: 90;
    height: 90%;
}

#preview-dialog {
    width: 96%;
    height: 96%;
}

#help-content,
#preview-content {
    height: 1fr;
    margin-top: 1;
    scrollbar-size-vertical: 1;
}

/* Login. The QR code has its own black and white, so nothing here may colour #qr-box. */

#login-dialog {
    height: auto;
    scrollbar-size-vertical: 1;
}

#login-form > Label {
    margin-bottom: 1;
    color: $text-muted;
}

#qr-status,
#qr-box,
#browser-hint {
    display: none;
}

#qr-status {
    height: 1;
}

#qr-status-lbl {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#qr-countdown-lbl {
    color: $text-muted;
    text-style: bold;
}

#qr-box {
    text-align: center;
    text-wrap: nowrap;
}

#browser-hint {
    margin-top: 1;
    width: 100%;
    height: auto;
    color: $text-muted;
}

LoginModal.-qr #login-form,
LoginModal.-browser #login-form {
    display: none;
}

LoginModal.-qr #qr-status,
LoginModal.-qr #qr-box,
LoginModal.-browser #qr-status,
LoginModal.-browser #browser-hint {
    display: block;
}

LoginModal.-browser #qr-status {
    height: auto;
}

LoginModal.-browser #qr-status-lbl {
    text-wrap: wrap;
    text-overflow: clip;
    height: auto;
    margin-right: 1;
}

LoginModal.-qr.-short Footer {
    display: none;
}

LoginModal.-qr.-short #login-dialog {
    width: 100%;
    padding: 0;
    border: none;
}
